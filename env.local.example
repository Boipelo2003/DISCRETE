# .env.local.example
# Copy these into Vercel: Project Settings > Environment Variables.
# Get the values from the same service account JSON you downloaded for
# setAdminClaim.js (Firebase Console > Project Settings > Service Accounts).

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Paste the private key as a single line with literal \n sequences (not real
# line breaks) — Vercel's env var UI doesn't handle multi-line values well,
# which is why orders-auth-snippet.js does .replace(/\\n/g, '\n') on it.

# DELETE this var once orders.js no longer reads it:
# ADMIN_SECRET=Disc2026$orders
